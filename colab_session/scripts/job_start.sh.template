mkdir -p /root/.colab-jobs

cat <<'EOF' > /root/.colab-jobs/sitecustomize.py
{{SITECUSTOMIZE_CONTENT}}
EOF

cat <<'EOF' > /root/.colab-jobs/remote_quota_manager.py
{{QUOTA_MANAGER_CONTENT}}
EOF
chmod +x /root/.colab-jobs/remote_quota_manager.py

cat <<'EOF' > {{WRAPPER_PATH}}
{{WRAPPER_CONTENT}}
EOF
chmod +x {{WRAPPER_PATH}}
cat <<'EOF' > {{META_PATH}}
{{META_JSON}}
EOF
nohup {{WRAPPER_PATH}} > /root/.colab-jobs/{{JOB_ID}}.log 2>&1 &
echo $! > /root/.colab-jobs/{{JOB_ID}}.pid


